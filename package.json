{
  "name": "soldaten-wohnen",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind CSS build for the Soldaten Wohnen Spring Boot backend. This package.json exists so IntelliJ IDEA can provide Tailwind CSS class autocompletion in KTE templates and to run the Tailwind build and class sorting scripts. It does not contain a JavaScript frontend.",
  "scripts": {
    "build": "tailwindcss -i ./src/main/resources/assets/styles.css -o ./src/main/resources/static/css/app.css",
    "build-prod": "tailwindcss -i ./src/main/resources/assets/styles.css -o ./src/main/resources/static/css/app.css --minify",
    "watch": "tailwindcss -i ./src/main/resources/assets/styles.css -o ./src/main/resources/static/css/app.css --watch",
    "sort-classes": "node scripts/sort-tailwind-classes.mjs",
    "sort-classes:check": "node scripts/sort-tailwind-classes.mjs --check"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.1",
    "daisyui": "^5.6.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.1"
  }
}
