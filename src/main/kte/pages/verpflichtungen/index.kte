@import org.zdigdemo.edge.controller.VerpflichtungViewModel2
@import org.zdigdemo.edge.repositories.VerpflichtungSortData

@param verpflichtungenListe: List<VerpflichtungViewModel2>
@param sortierInformation: VerpflichtungSortData

!{val anzahlElementeInVerpflichtungenliste = verpflichtungenListe.size}

@template.layout.layout(title = "Verpflichtungen", content =@`
	<div
			class="mx-auto grid h-full w-full max-w-7xl grid-cols-2 gap-4 overflow-y-auto p-4 lg:grid-cols-2 lg:overflow-hidden"
			x-data="{ detailViewOpen: false }"
			@keydown.escape.window="detailViewOpen = false"
	>
		<section
				class="col-span-2 flex min-h-0 flex-col gap-4"
				:class="detailViewOpen ? 'lg:col-span-1' : 'lg:col-span-2'"
		>
			<div class="flex flex-wrap items-center justify-between gap-4 rounded-box bg-base-200 p-4 shadow-sm">
				<div class="flex items-center gap-3">
					<span class="font-medium">Verpflichtungsanzahl</span>
					<span id="verpflichutngenAnzahlContainer"
						  class="badge badge-lg badge-primary">${anzahlElementeInVerpflichtungenliste}</span>
				</div>
				<a class="btn btn-primary" href="/verpflichtungen/create">
					Neue Verpflichtung
				</a>

				<label class="form-control w-full max-w-xs">
					<span class="label py-1">Search</span>
					<!--So hx-sync="this:replace" reads literally as: "sync against myself; when I issue a new request while one of-->
					<!--mine is still in flight, abort the in-flight one and replace it with the new one."-->
					<input
							id="searchInput"
							type="search"
							name="sucheingabe"
							placeholder="z. B. 123"
							class="input-bordered input w-full"
							hx-trigger="input changed delay:150ms"
							hx-get="/verpflichtungen"
							hx-target="#verpflichtungstabelleContainer"
							hx-swap="innerHTML"
							hx-sync="this:replace"
					>
				</label>
			</div>

			<div id="verpflichtungstabelleContainer"
				 class="min-h-0 flex-1 overflow-auto rounded-box border border-base-300 bg-base-100 shadow-sm">
				@template.pages.verpflichtungen.components.obligationListWithDetailView(verpflichtungenListe = verpflichtungenListe, sortierInformation = sortierInformation)
			</div>
		</section>
	</div>
`)
