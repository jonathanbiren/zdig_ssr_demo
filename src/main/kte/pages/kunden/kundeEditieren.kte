@import org.soldatenwohnen.adapter.`in`.KundePresentationModel

@param kunde: KundePresentationModel

@template.layout.layout(title = "Editieren | ${kunde.kurzname}", content = @`
	<section
			class="h-full flex flex-col gap-4 p-4 mx-auto w-full max-w-7xl mt-2"
	>
		<div class="flex flex-wrap items-center justify-between gap-4 bg-base-200 rounded-box p-4 shadow-sm">
			<h1 class="text-xl text-white">Editieren von Kunde ${kunde.name}</h1>
		</div>
	</section>
`)