@import org.zdigdemo.edge.controller.KundeViewModel
@import org.zdigdemo.edge.repositories.SortData

@param kundenListe: List<KundeViewModel>
@param sortierInformation: SortData
<%--You can compute values from the data which is passed into the template --%>
!{val anzahlElementeInKundenliste = kundenListe.size}

@template.layout.layout(title = "SFA | Kunde", content = @`
	<div
			class="mx-auto grid h-full w-full max-w-7xl grid-cols-2 gap-4 overflow-y-auto p-4 lg:grid-cols-2 lg:overflow-hidden"
			x-data="{ detailViewOpen: false }"
			@keydown.escape.window="detailViewOpen = false"
	>
		<section
				class="col-span-2 flex min-h-0 flex-col gap-4"
				:class="detailViewOpen ? 'lg:col-span-1' : 'lg:col-span-2'"
	>
		<div class="flex flex-wrap items-center justify-between gap-4 rounded-box bg-base-200 p-4 shadow-sm">
			<div class="flex items-center gap-3">
				<span class="font-medium">Kundenanzahl</span>
				<span id="kundenanzahlContainer"
				      class="badge badge-lg badge-primary">${anzahlElementeInKundenliste}</span>
			</div>
			<a class="btn btn-primary" href="/kunden/create">
				Neuer Kunde
			</a>

				<label class="form-control w-full max-w-xs">
					<span class="label py-1">Search</span>
					<!--So hx-sync="this:replace" reads literally as: "sync against myself; when I issue a new request while one of-->
					<!--mine is still in flight, abort the in-flight one and replace it with the new one."-->
					<input
							id="searchInput"
							type="search"
							name="sucheingabe"
							placeholder="z. B. 123"
							class="input-bordered input w-full"
							hx-trigger="input changed delay:150ms"
							hx-get="/kunden"
							hx-target="#kundentabelleContainer"
							hx-swap="innerHTML"
							hx-sync="this:replace"
					>
				</label>
			</div>

			<div id="kundentabelleContainer"
			     class="min-h-0 flex-1 overflow-auto rounded-box border border-base-300 bg-base-100 shadow-sm">
				@template.pages.kunden.components.clientListWithDetailView(kundenListe = kundenListe, sortierInformation = sortierInformation)
			</div>
		</section>

		<aside
				class="col-span-1 flex min-h-0 flex-col overflow-hidden rounded-box border border-base-300 bg-base-100 shadow-sm lg:col-span-1"
				x-show="detailViewOpen"
				x-transition.scale.20
		>
			<div class="flex shrink-0 items-center justify-between border-b border-base-300 p-4">
				<h2 class="text-lg font-semibold">Kundendetails</h2>
				<button
						type="button"
						class="btn btn-ghost btn-sm btn-circle"
						aria-label="Detailansicht schließen"
						@click="detailViewOpen = false"
				>
					✕
				</button>
			</div>
			<div id="detail-view-content" class="min-h-0 flex-1 overflow-y-auto">
				<p class="p-4 text-sm opacity-70">Wählen Sie einen Kunden aus.</p>
			</div>
		</aside>
	</div>
`)
