@import org.soldatenwohnen.adapter.`in`.KundePresentationModel
@import org.soldatenwohnen.adapter.`in`.VerpflichtungPresentationModel

@param kunde: KundePresentationModel
@param verpflichtungen: List<VerpflichtungPresentationModel>

<div class="flex flex-col gap-4 p-4">
	<div>
		<h3 class="text-lg font-semibold">${kunde.name}</h3>
		<p class="text-sm opacity-70">${kunde.kurzname} &middot; ZS-NR ${kunde.zsNummer}</p>
		<p class="text-sm opacity-70">${kunde.adresse} &middot; ${kunde.status}</p>
		@if(kunde.istBesondersSchuetzenswert)
			<span class="mt-1 badge badge-sm badge-warning">Besonders sch&uuml;tzenswert</span>
		@endif
	</div>

	<div>
		<h4 class="font-medium">Verpflichtungen</h4>
		@if(verpflichtungen.isEmpty())
			<p class="text-sm opacity-70">Keine Verpflichtungen vorhanden.</p>
		@else
			<ul class="list-disc pl-5">
				@for(v in verpflichtungen)
					<li class="text-sm">${v.bezeichnung} &ndash; ${v.betrag}</li>
				@endfor
			</ul>
		@endif
	</div>
</div>
