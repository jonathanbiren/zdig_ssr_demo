@import org.zdigdemo.edge.repositories.KundeViewModel
@import org.zdigdemo.edge.repositories.SortData
@import org.zdigdemo.edge.repositories.SortDirection

@param kundenListe: List<KundeViewModel>
@param sortierInformation: SortData

<table class="table table-pin-rows table-zebra table-lg">
	<thead>
	<tr>
		@for(entry in sortierInformation.columnNames)
			!{val currentColumnIsSortingColumn = sortierInformation.sortColumn.requestName == entry.requestName}
			!{val nextSortDirection = if(currentColumnIsSortingColumn) sortierInformation.sortDirection.invert() else SortDirection.ASC}

			<th>
				<button
						class="btn btn-ghost"
						hx-trigger="click"
						hx-get="/kunden"
						hx-target="#kundentabelleContainer"
						hx-swap="innerHTML"
						hx-include="#searchInput"
						hx-vals='{
							"sortColumn": "${entry.requestName}",
							"sortDirection": "${nextSortDirection.value}"
						}'
				>
					${entry.viewName}
					@if(currentColumnIsSortingColumn)
						@if(sortierInformation.sortDirection.isAscending())
							⬇️
						@else
							⬆️
						@endif
					@endif
				</button>
			</th>
		@endfor
		<th>Aktion</th>
	</tr>
	</thead>
	<tbody>
	@for(kunde in kundenListe)
		<tr
				class="cursor-pointer row-hover"
				@click="detailViewOpen = true"
				hx-trigger="click"
				hx-get="/kunden/${kunde.id}/detail"
				hx-target="#detail-view-content"
				hx-swap="innerHTML"
				hx-sync="this:replace"
				hx-indicator="#kunden-detail-loading"
		>
			<td>${kunde.kurzname}</td>
			<td>${kunde.name}</td>
			<td>${kunde.zsNummer}</td>
			<td>${kunde.adresse}</td>
			<td>${kunde.status}</td>
			<td>${kunde.istBesondersSchuetzenswert}</td>
			<td @click.stop>
				<button class="btn btn-neutral btn-sm"
				   href="/kunden/${kunde.id}/edit">
					Edit
				</button>
				<button class="btn btn-neutral btn-sm"
				        hx-trigger="click"
				        hx-confirm="Sind Sie sich sicher, dass Sie den Kunden löschen wollen?"
				        hx-delete="/kunden/${kunde.id}"
				>
					Delete
				</button>
			</td>
		</tr>
	@endfor
	</tbody>
</table>
