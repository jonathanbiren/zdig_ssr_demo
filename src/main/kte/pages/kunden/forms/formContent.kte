@import org.zdigdemo.edge.controller.KundeDTO

@param kunde: KundeDTO

<div class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-6">
    @template.components.form.textField(
    name = "name",
    label = "Kundenname",
    value = kunde.name,
    required = true,
    validationEndpoint = "/kunden/" + kunde.id.toString() + "/validateName",
    wrapperClass = "sm:col-span-4"
    )

    @template.components.form.textField(
    name = "kurzname",
    label = "Kundenkurzname",
    value = kunde.kurzname,
    required = true,
    validationEndpoint = "/kunden/" + kunde.id.toString() + "/validateKurzname",
    wrapperClass = "sm:col-span-2"
    )

    @template.components.form.textField(
    name = "adresse",
    label = "Adresse",
    value = kunde.adresse,
    wrapperClass = "col-span-full"
    )

    @template.components.form.textField(
    name = "zsNummer",
    label = "ZS-NR",
    value = kunde.zsNummer,
    validationEndpoint = "/kunden/" + kunde.id.toString() + "/validateZsNr",
    wrapperClass = "sm:col-span-2 sm:col-start-1"
    )

    @template.components.form.textField(
    name = "status",
    label = "Status",
    value = kunde.status,
    wrapperClass = "sm:col-span-2"
    )

    @template.components.form.selectField(
    name = "istBesondersSchuetzenswert",
    label = "Besonders Schützenwert",
    value = kunde.istBesondersSchuetzenswert.toString(),
    options = listOf(
            Pair("true", "Ja"),
            Pair("false", "Nein")),
    wrapperClass = "sm:col-span-2")

    <div class="divider sm:col-span-6"></div>

    <div class="flex items-center justify-end gap-x-6 sm:col-span-6">
        <button class="btn">Abbrechen</button>
        <button type="submit" class="btn btn-primary">Speichern</button>
    </div>
</div>

