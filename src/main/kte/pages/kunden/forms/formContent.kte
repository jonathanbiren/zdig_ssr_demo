@import org.zdigdemo.edge.controller.KundeDTO

@param kunde: KundeDTO

<div class="border-b border-gray-900/10 pb-12">

    <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
        <div class="sm:col-span-4">
            <label for="name" class="block text-sm font-medium leading-6 text-gray-900">
                Kundenname <span class="text-red-500">*</span>
            </label>
            <div class="mt-2">
                <input type="text"
                       name="name"
                       id="name"
                       value="${kunde.name}"
                       class="block w-full rounded-md border-0 px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
            </div>
        </div>

        <div class="sm:col-span-2">
            <label for="kurzname" class="block text-sm font-medium leading-6 text-gray-900">
                Kundenkurzname <span class="text-red-500">*</span>
            </label>
            <div class="mt-2">
                <input type="text"
                       name="kurzname"
                       id="kurzname"
                       value="${kunde.kurzname}"
                       class="block w-full rounded-md border-0 px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
            </div>
        </div>

        <div class="col-span-full">
            <label for="adresse"
                   class="block text-sm font-medium leading-6 text-gray-900">Adresse</label>
            <div class="mt-2">
                <input type="text" name="adresse" id="adresse" value="${kunde.adresse}"
                       class="block w-full rounded-md border-0 px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
            </div>
        </div>

        <div class="sm:col-span-2 sm:col-start-1">
            <label for="zsNummer" class="block text-sm font-medium leading-6 text-gray-900">ZS-NR</label>
            <div class="mt-2">
                <input type="text" name="zsNummer" id="zsNummer"
                       hx-get="/kunden/${kunde.id.toString()}/validateZsNr"
                       hx-trigger="input changed delay:300ms"
                       hx-target="#zsNummer-validation"
                       hx-swap="outerHTML"
                       aria-describedby="zsNummer-validation"
                       value="${kunde.zsNummer}"
                       class="block w-full rounded-md border-0 px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                <span id="zsNummer-validation"></span>
            </div>
        </div>


        <div class="sm:col-span-2">
            <label for="status" class="block text-sm font-medium leading-6 text-gray-900">Status</label>
            <div class="mt-2">
                <input type="text" name="status" id="status" value="${kunde.status}"
                       class="block w-full rounded-md border-0 px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
            </div>
        </div>

        <div class="sm:col-span-2">
            <label for="istBesondersSchuetzenswert" class="block text-sm font-medium leading-6 text-gray-900">Besonders
                Schützenwert</label>
            <select id="istBesondersSchuetzenswert" name="istBesondersSchuetzenswert"
                    class="block mt-2 w-full rounded-md border-0 px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:max-w-xs sm:text-sm sm:leading-6">
                <option value="true" selected="${kunde.istBesondersSchuetzenswert}">Ja</option>
                <option value="false" selected="${!(kunde.istBesondersSchuetzenswert)}">Nein</option>
            </select>
        </div>
    </div>
</div>

<div class="mt-6 flex items-center justify-end gap-x-6">
    <button type="button" class="text-sm font-semibold leading-6 text-gray-900">Cancel</button>
    <button type="submit"
            class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
        Save
    </button>
</div>
