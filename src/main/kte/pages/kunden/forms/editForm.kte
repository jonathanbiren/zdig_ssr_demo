@import org.zdigdemo.edge.controller.KundeDTO

@param kunde: KundeDTO
@template.layout.layout(title = "Editieren | ${kunde.kurzname}", content = @`
    <section
            class="mx-auto mt-2 flex h-full w-full max-w-7xl flex-col gap-4 p-4"
    >
        <div class="flex flex-wrap items-center justify-between gap-4 rounded-box bg-base-200 p-4 shadow-sm">
            <h1 class="text-xl text-white">Editieren von Kunde ${kunde.name}</h1>
        </div>
        <div class="max-w-3xl mx-auto bg-white rounded-xl shadow-md">
            <form class="p-6" hx-patch="/kunden/${kunde.id.toString()}/save">
                <input type="hidden" name="id" value="${kunde.id.toString()}">
                @template.pages.kunden.forms.formContent(kunde = kunde)
            </form>
        </div>
    </section>
`)
