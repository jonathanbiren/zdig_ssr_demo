@import kotlin.collections.toString
@import org.zdigdemo.edge.controller.KundeDTO

@param kunde: KundeDTO
@template.layout.layout(title = "Neuer Kunde", content = @`
    <section class="mx-auto mt-2 flex h-full w-full max-w-3xl flex-col gap-4 p-4">
        <div class="flex flex-wrap items-center justify-between gap-4 rounded-box bg-base-100 p-4 shadow-sm">
            <h1 class="text-xl font-medium">Einen neuen Kunden anlegen</h1>
        </div>

        <div class="w-full rounded-xl bg-white shadow-md">
            <form class="p-6"
                  hx-post="/kunden/${kunde.id.toString()}/save"
                  hx-target="#form-errors"
                  hx-swap="innerHTML">
                <input type="hidden" name="id" value="${kunde.id.toString()}">
                <div id="form-errors"></div>
                @template.pages.kunden.forms.formContent(kunde = kunde)
            </form>
        </div>
    </section>
`)
