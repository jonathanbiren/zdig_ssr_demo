@import org.soldatenwohnen.adapter.`in`.KundePresentationModel

@param kundenListe: List<KundePresentationModel>

<div x-data="{slideOverOpen: false}">
	<table class="table table-pin-rows table-zebra table-lg">
		<thead>
		<tr class="bg-base-200">
			<th>Kurzname</th>
			<th>Name</th>
			<th>ZS-NR</th>
			<th>Adresse</th>
			<th>Status</th>
			<th>Besonders Schützenswert</th>
			<th>Aktion</th>
		</tr>
		</thead>
		<tbody>
		@for(kunde in kundenListe)
			<tr
					class="cursor-pointer row-hover"
					<%--:class="selectedId == rowId ? 'active' : ''"--%>
					@click="slideOverOpen = true"
					hx-trigger="click"
					hx-get="/kunden/${kunde.id}/detail"
					hx-target="#side-panel-content"
					hx-swap="innerHTML"
					hx-sync="this:replace"
			>
				<td>${kunde.kurzname}</td>
				<td>${kunde.name}</td>
				<td>${kunde.zsNummer}</td>
				<td>${kunde.adresse}</td>
				<td>${kunde.status}</td>
				<td>${kunde.istBesondersSchuetzenswert}</td>
				<td @click.stop>
					<a class="btn btn-neutral btn-sm"
					   href="/kunden/${kunde.id}/edit">
						Edit
					</a>
					<button class="btn btn-neutral btn-sm"
					        hx-trigger="click"
					        hx-delete="/kunden/${kunde.id}/delete"
					        hx-target="closest tr"
					        hx-swap="outerHTML">
						Delete
					</button>
				</td>
			</tr>
		@endfor
		</tbody>
	</table>


	<aside
			class="relative z-50 h-auto w-auto"
	>
		<template x-teleport="body">
			<div
					x-show="slideOverOpen"
					@keydown.window.escape="slideOverOpen=false"
					class="relative z-99"
			>
				<div class="fixed inset-0 overflow-hidden">
					<div class="absolute inset-0 overflow-hidden">
						<div class="fixed inset-y-0 right-0 flex max-w-full pl-10">
							<div
									x-show="slideOverOpen"
									@click.outside="slideOverOpen = false"
									x-transition:enter="transform transition ease-in-out duration-500 sm:duration-700"
									x-transition:enter-start="translate-x-full"
									x-transition:enter-end="translate-x-0"
									x-transition:leave="transform transition ease-in-out duration-500 sm:duration-700"
									x-transition:leave-start="translate-x-0"
									x-transition:leave-end="translate-x-full"
									class="w-screen max-w-md">
								<div class="flex h-full flex-col overflow-y-scroll border-l border-neutral-100/70 bg-white py-5 shadow-lg">
									<div class="px-4 sm:px-5">
										<div class="flex items-start justify-between pb-1">
											<h2 class="text-base leading-6 font-semibold text-gray-900"
											    id="slide-over-title">Slide Over Title</h2>
											<div class="ml-3 flex h-auto items-center">
												<button @click="slideOverOpen=false"
												        class="absolute right-0 z-30 mt-6 mr-5 flex items-center justify-center space-x-1 rounded-md border border-neutral-200 px-3 py-2 text-xs font-medium text-neutral-600 uppercase hover:bg-neutral-100">
													<svg xmlns="http://www.w3.org/2000/svg" fill="none"
													     viewBox="0 0 24 24" stroke-width="1.5"
													     stroke="currentColor"
													     class="h-4 w-4">
														<path stroke-linecap="round" stroke-linejoin="round"
														      d="M6 18L18 6M6 6l12 12"></path>
													</svg>
													<span>Close</span>
												</button>
											</div>
										</div>
									</div>
									<div class="relative mt-5 flex-1 px-4 sm:px-5">
										<div class="absolute inset-0 px-4 sm:px-5">
											<div id="side-panel-content"
											     class="relative h-full overflow-hidden rounded-md border border-dashed border-neutral-300">
												This is the div which contains the content of the side menu
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</template>
	</aside>
</div>
