@import gg.jte.Content
@param title: String
@param content: Content

<!DOCTYPE html>
<html lang="de">
@template.fragments.head(title = title)
<div class="h-screen w-full flex flex-col overflow-hidden bg-secondary">
	<header class="shrink-0">
		<nav class="navbar bg-base-100 shadow-sm">
			<a class="btn btn-ghost text-xl">SFA</a>
		</nav>
	</header>

	<main class="flex-1 min-h-0 overflow-hidden">
		${content}
	</main>

	<footer class="shrink-0">
		<div class="footer sm:footer-horizontal bg-neutral text-neutral-content p-10">
			<nav>
				ZDig BW
			</nav>
		</div>
	</footer>
</div>
</html>
