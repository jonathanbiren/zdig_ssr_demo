@param name: String
@param label: String
@param value: String
@param options: List<Pair<String, String>>
@param required: Boolean = false
@param wrapperClass: String = ""
@param selectClass: String = ""
@param labelClass: String = ""

<div class="${wrapperClass}">
    <fieldset class="fieldset">
        <label for="${name}" class="label ${labelClass}">
            ${label}
            @if(required)
                <span class="text-red-500">*</span>
            @endif
        </label>

        <select
                id="${name}"
                name="${name}"
                class="select select-bordered w-full ${selectClass}"
        >
            @for(option in options)
                <option value="${option.first}" selected="${option.first == value}">
                    ${option.second}
                </option>
            @endfor
        </select>
    </fieldset>
</div>